# ─────────────────────────────────────────────────────────────────────────────
# Variables de Entorno — Sistema Integral de Préstamos PrestaPerú
# ─────────────────────────────────────────────────────────────────────────────
# NOTA IMPORTANTE PARA CARACTERES ESPECIALES EN LA CONTRASEÑA DE BASE DE DATOS:
# Si tu contraseña contiene caracteres especiales como '+', '@', ':', '#', '/', '%',
# debes codificarlos en formato URL (URL Encoded):
#   - '+'  -->  '%2B'
#   - '@'  -->  '%40'
#   - '#'  -->  '%23'
#   - '$'  -->  '%24'
#
# Ejemplo: si la contraseña es '23111998_Mb+24', en la URL debe ser '23111998_Mb%2B24'
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. BASE DE DATOS POSTGRESQL (Supabase / Pooler) ──────────────────────────
# Conexión principal para consultas (Transaction Pooler - puerto 6543):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa para migraciones y Prisma CLI (Direct Connection - puerto 5432):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── 2. AUTENTICACIÓN Y SEGURIDAD ─────────────────────────────────────────────
NEXTAUTH_SECRET="super-secret-key-change-in-production"
NEXTAUTH_URL="https://tu-dominio.vercel.app" # o http://localhost:3000 en local
AUTH_SECRET="super-secret-key-change-in-production"

# ─── 3. SUPABASE STORAGE (Subida de fotos KYC y Vouchers) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-secret-key"

# ─── 4. CREDENCIALES ADMINISTRADOR INICIAL ────────────────────────────────────
ADMIN_EMAIL="admin@prestamos.pe"
ADMIN_PASSWORD="Admin123!"

# ─── 5. DIRECTORIO LOCAL DE ARCHIVOS (Fallback de desarrollo) ────────────────
UPLOAD_DIR="public/uploads"
